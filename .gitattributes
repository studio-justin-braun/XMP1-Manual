# Auto detect text files and perform LF normalization
* text=auto

*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.png binary
*.pdf binary
*.HLP binary
# Decompiled originals retain their original encoding and exact bytes.
Quellen/dekompiliert/* -text
